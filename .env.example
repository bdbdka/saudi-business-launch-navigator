# Manual backend/frontend development template. Copy this file to .env only
# when running outside Compose, supply a separately managed demo database URL,
# and never commit .env. For the complete local stack, use the Compose workflow
# documented in README.md.
SBLN_ENVIRONMENT=local
SBLN_LOG_LEVEL=INFO
SBLN_DATABASE_URL=
SBLN_CATALOG_MODE=PORTFOLIO_DEMO_CATALOG
SBLN_EXPECTED_DATABASE_IDENTITY=143e0ec8-ff17-5955-8e89-aab9932a2577
SBLN_EXPECTED_DATABASE_NAME=navigator_portfolio_demo
SBLN_OPENAI_MODEL=gpt-5.6
SBLN_OPENAI_TIMEOUT_SECONDS=20
SBLN_OPENAI_MAX_OUTPUT_TOKENS=1200
SBLN_API_MAX_NATURAL_LANGUAGE_CHARS=2000
SBLN_API_MAX_REQUEST_BYTES=16384
SBLN_CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
SBLN_ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
SBLN_API_DOCS_ENABLED=true

# Optional. Keep the real value outside Git and never log it. The guided
# deterministic workflow remains available when this is blank.
OPENAI_API_KEY=
