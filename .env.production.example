# Production configuration contract. Copy to an ignored environment file or,
# preferably, configure these values in the hosting platform's secret manager.
# Every hostname below is illustrative and MUST be replaced before deployment.

SBLN_ENVIRONMENT=production
SBLN_PRODUCTION_REHEARSAL=false
SBLN_LOG_LEVEL=INFO
# postgresql+psycopg URLs must include sslmode=require, verify-ca, or verify-full.
# Standard managed-provider postgresql:// URLs are normalized to Psycopg 3 with
# sslmode=require by the backend before engine creation.
SBLN_DATABASE_URL=
SBLN_CATALOG_MODE=PORTFOLIO_DEMO_CATALOG
SBLN_EXPECTED_DATABASE_IDENTITY=143e0ec8-ff17-5955-8e89-aab9932a2577
SBLN_EXPECTED_DATABASE_NAME=navigator_portfolio_demo
SBLN_DEMO_RUNTIME_DATABASE_PASSWORD=
SBLN_API_DOCS_ENABLED=false
SBLN_CORS_ALLOWED_ORIGINS=["https://navigator.example.invalid"]
SBLN_ALLOWED_HOSTS=["api.navigator.example.invalid"]
SBLN_API_MAX_NATURAL_LANGUAGE_CHARS=2000
SBLN_API_MAX_REQUEST_BYTES=16384
SBLN_OPENAI_MODEL=gpt-5.6
SBLN_OPENAI_TIMEOUT_SECONDS=20
SBLN_OPENAI_MAX_OUTPUT_TOKENS=1200

# Optional. The deterministic workflow must remain usable when this is absent.
OPENAI_API_KEY=
