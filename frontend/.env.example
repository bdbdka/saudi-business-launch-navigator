# Browser-safe public configuration only. Never place API keys, database URLs,
# tokens, or other secrets in NEXT_PUBLIC_* variables.
# In production, set the approved browser-reachable HTTPS API origin. Production
# builds fail closed when this value or the explicit catalog mode is missing.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_CATALOG_MODE=PORTFOLIO_DEMO_CATALOG
